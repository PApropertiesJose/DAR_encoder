<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Remove first to avoid duplicate MIME type errors on IIS -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- Leave AdminWorkerTaskMonitoring requests alone -->
        <rule name="Ignore AdminWorkerTaskMonitoring" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/AdminWorkerTaskMonitoring" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- SPA fallback: rewrite all non-file requests to index.html -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/DAR/" />
        </rule>
      </rules>
    </rewrite>

    <!-- Allow the service worker to control the full /DAR/ scope -->
    <httpProtocol>
      <customHeaders>
        <add name="Service-Worker-Allowed" value="/DAR/" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
